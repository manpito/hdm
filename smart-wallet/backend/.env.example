PORT=3001
JWT_SECRET=smart-wallet-secret-key-123
MAX_POS_TERMINALS=2

# Origens autorizadas a aceder à API, separadas por vírgula (IP ou domínio deste servidor).
# Se omitido, só é aceite localhost.
# CORS_ORIGINS=http://<IP-DO-SERVIDOR>:5173,http://<IP-DO-SERVIDOR>:5174

# Backup local (scripts/backup.js). Pasta de destino, idealmente noutro disco físico.
# BACKUP_DIR=D:\SmartWalletBackups
# BACKUP_KEEP_HOURLY=48
# BACKUP_KEEP_DAILY=30

# Envio diário cifrado para o servidor central (scripts/offsite.js). Ver smart-wallet/deploy/offsite/README.md.
# A chave OFFSITE_KEY gera-se com "npm run backup:offsite -- --generate-key" e guarda-se também fora deste servidor
# (gestor de senhas). Sem ela não é possível restaurar as cópias enviadas. Nunca a copiar para o servidor central.
# OFFSITE_KEY=
# OFFSITE_HOST=
# OFFSITE_PORT=22
# OFFSITE_USER=sw-<cliente>
# OFFSITE_SSH_KEY=C:\SmartWallet\offsite\id_offsite
# OFFSITE_KNOWN_HOSTS=C:\SmartWallet\offsite\known_hosts
# OFFSITE_TENANT=<cliente>

# Endereço de escuta do backend. Com 127.0.0.1 a API só é acessível através do Nginx (/api).
# Se omitido, escuta em todas as interfaces (IPv4 e IPv6).
# HOST=127.0.0.1
